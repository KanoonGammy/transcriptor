# ===================================================
# Transcriptor - Environment Configuration
# ===================================================

# Port & Host
HOST=0.0.0.0
PORT=16872

# Security / JWT Secret (Please change in production)
JWT_SECRET=super-secret-key-change-this-in-production-1234567890
JWT_EXPIRATION_HOURS=72

# Default Admin Account (Will be created on first start if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME=System Administrator

# Optional: ElevenLabs API Key (Can also be set in Webapp Settings UI)
ELEVENLABS_API_KEY=

# Storage Retention Policy for Raw Audio Files:
# Options: "keep_all", "1_day", "3_days", "7_days", "30_days", "immediate"
AUDIO_RETENTION_POLICY=7_days
